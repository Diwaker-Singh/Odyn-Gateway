{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Chat request structure",
  "type": "object",
  "required": [
    "model",
    "messages",
    "max_tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "max_tokens": {
      "type": "integer"
    }
  }
}
